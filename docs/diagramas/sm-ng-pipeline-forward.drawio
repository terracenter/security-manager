        <mxCell id="e_f4_f5" value="no match" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_f5_drop" value="match" style="endArrow=block;html=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="f5" target="f5drop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f5_f5b" value="no match" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="f5" target="f5b"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_f5b_acc" value="match accept" style="endArrow=block;html=1;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="f5b" target="f5bacc"><mxGeometry relative="1" as="geometry" /></mxCell>
