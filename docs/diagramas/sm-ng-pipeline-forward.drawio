<mxfile host="app.diagrams.net" type="device">
  <diagram name="SM-NG Pipeline forward" id="sm-ng-pipeline-forward">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="title" value="Security-Manager-NG — Pipeline de forward (tabla inet sm_forward)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- ===== Columna lateral: SETS DUPLICADOS ===== -->
        <mxCell id="sets_box" value="SETS (duplicados de table inet sm —&#10;nftables no comparte sets entre tablas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="260" width="240" height="330" as="geometry" />
        </mxCell>
        <mxCell id="set_wl" value="sm_whitelist4 / sm_whitelist6&#10;(Tier A — confiable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="300" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="set_im" value="sm_immune4 / sm_immune6&#10;(Tier B — intocable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="360" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="set_bl" value="sm_blacklist4 / sm_blacklist6&#10;(bans manuales)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="set_store" value="internal/store (sm-ng.db)&#10;forward_rules — motor T-4.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="480" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="set_note" value="Sin GeoIP: saddr en forward&#10;suele ser privado (T-4.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="540" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- ===== Entrada ===== -->
        <mxCell id="pkt" value="📥 Paquete en tránsito&#10;(routing / Docker / VPN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="chain" value="chain forward&#10;hook forward · priority filter · policy DROP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#0b1b3a;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="340" height="50" as="geometry" />
        </mxCell>

        <!-- 1 FASTPATH -->
        <mxCell id="f1" value="1 · ct state established,related ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="240" width="260" height="70" as="geometry" />
