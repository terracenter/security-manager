        <mxCell id="e_f4_f5" value="no match" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f5_drop" value="match" style="endArrow=block;html=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="f5" target="f5drop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f5_f6" value="no match" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f6_acc" value="match" style="endArrow=block;html=1;fontSize=9;strokeColor=#82b366;" edge="1" parent="1" source="f6" target="f6acc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f6_f7" value="no match" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f7_drop" value="país no permitido" style="endArrow=block;html=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="f7" target="f7drop"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f7_srv" value="país permitido / no geoip" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="f7" target="srv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_srv_def" value="no match" style="endArrow=block;html=1;fontSize=9;" edge="1" parent="1" source="srv" target="def"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- flechas a sets (referencia, punteadas) -->
        <mxCell id="e_f5_setbl" style="endArrow=open;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="f5" target="set_bl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f6_setwl" style="endArrow=open;html=1;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="f6" target="set_wl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f7_setgeo" style="endArrow=open;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="f7" target="set_geo"><mxGeometry relative="1" as="geometry" /></mxCell>
