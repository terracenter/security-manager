<mxfile host="app.diagrams.net" type="device">
  <diagram name="SM-NG Pipeline nftables" id="sm-ng-pipeline">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="title" value="Security-Manager-NG — Pipeline de filtrado (tabla inet sm)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="760" height="40" as="geometry" />
        </mxCell>

        <!-- ===== Columna lateral: SETS NATIVOS ===== -->
        <mxCell id="sets_box" value="SETS NATIVOS (flags interval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;align=center;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="300" width="240" height="430" as="geometry" />
        </mxCell>
        <mxCell id="set_wl" value="sm_whitelist4 / sm_whitelist6&#10;(SSoT — infra confiable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="340" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="set_bl" value="sm_blacklist4 / sm_blacklist6&#10;(bans manuales)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="410" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="set_geo" value="geoip_&lt;cc&gt;4 / geoip_&lt;cc&gt;6&#10;(por país permitido)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="480" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="set_f2b" value="tabla aparte: f2b-table&#10;(fail2ban, banaction nftables —&#10;coexiste con inet sm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="550" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="set_nat" value="chain postrouting (type nat)&#10;oifname $WAN masquerade&#10;(NAT WireGuard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="640" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Entrada ===== -->
        <mxCell id="pkt" value="📥 Paquete entrante&#10;(WAN / LAN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="chain" value="chain input&#10;hook input · priority filter · policy DROP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#0b1b3a;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="320" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Zona SANEAMIENTO ===== -->
        <mxCell id="zone_san" value="SANEAMIENTO (fast-path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;align=left;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1 · ct state established,related" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2 · iif lo (loopback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3 · ct state invalid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Zona FILTRADO ===== -->
        <mxCell id="zone_fil" value="FILTRADO POR REPUTACIÓN / ORIGEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;align=left;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="700" height="430" as="geometry" />
        </mxCell>

        <!-- 4 ANTIRECON -->
        <mxCell id="f4" value="4 · ANTIRECON&#10;tcp flags XMAS / NULL / FIN+SYN / SYN+RST" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="410" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f4drop" value="limit rate → log &quot;SM-ANTIRECON&quot; → DROP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="425" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- 5 BLACKLIST -->
        <mxCell id="f5" value="5 · BLACKLIST&#10;ip saddr @sm_blacklist4/6 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="510" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f5drop" value="DROP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="525" width="190" height="40" as="geometry" />
        </mxCell>

        <!-- 6 WHITELIST -->
        <mxCell id="f6" value="6 · WHITELIST / SSoT&#10;ip saddr @sm_whitelist4/6 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="600" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f6acc" value="ACCEPT&#10;(bypass total — infra confiable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="610" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- 7 GEOIP -->
        <mxCell id="f7" value="7 · GEOIP (condicional)&#10;ip saddr @geoip_&lt;cc&gt; ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="690" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f7drop" value="log &quot;SM-GEOIP&quot; → DROP&#10;(país no permitido)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="705" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Zona SERVICIOS ===== -->
        <mxCell id="zone_srv" value="SERVICIOS PERMITIDOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontSize=11;align=left;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="srv" value="8 · tcp dport { 22 ssh, 80/443 acme/web }  → ACCEPT&#10;icmp / icmpv6 echo (limit rate)  → ACCEPT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="865" width="560" height="55" as="geometry" />
        </mxCell>

        <!-- DEFAULT DROP -->
        <mxCell id="def" value="9 · POLICY DROP  ·  log &quot;SM-DROP-DEFAULT&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7a2e2b;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="970" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- ===== FLECHAS principales ===== -->
        <mxCell id="e_pkt_chain" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="pkt" target="chain"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_chain_s1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="chain" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
