// Security-Manager-NG — Pipeline de filtrado (tabla inet sm)
// Render: dot -Tpng -Gdpi=150 sm-ng-pipeline-nftables.dot -o sm-ng-pipeline-nftables.png
digraph SM_NG_Pipeline {
    rankdir=TB;
    bgcolor="white";
    nodesep=0.45;
    ranksep=0.50;
    fontname="DejaVu Sans";
    fontsize=20;
    fontcolor="#1f3864";
    labelloc="t";
    label=<<b>Security-Manager-NG — Pipeline de filtrado (tabla inet sm)</b><br/> >;

    node [fontname="DejaVu Sans", fontsize=11, margin="0.12,0.07"];
    edge [fontname="DejaVu Sans", fontsize=9, color="#444444"];

    // ===== Entrada =====
    pkt   [label="Paquete entrante\n(WAN / LAN)", shape=box, style="rounded,filled", fillcolor="#bbdefb", color="#333333", penwidth=1.5];
    chain [label="chain input\nhook input  ·  priority filter  ·  policy DROP", shape=box, style="rounded,filled", fillcolor="#1f3864", fontcolor="white", color="#0b1b3a", penwidth=1.5];

    // ===== Zona SANEAMIENTO =====
    subgraph cluster_san {
        label="SANEAMIENTO (fast-path)";
        style="dashed,filled"; color="#999999"; fillcolor="#f5f5f5";
        fontsize=12; fontname="DejaVu Sans"; fontcolor="#555555";
        s1 [label="1 · ct state established,related\n→ ACCEPT", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
        s2 [label="2 · iif lo (loopback)\n→ ACCEPT", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
        s3 [label="3 · ct state invalid\n→ DROP", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
    }

    // ===== Zona FILTRADO =====
    subgraph cluster_fil {
        label="FILTRADO POR REPUTACIÓN / ORIGEN";
        style="dashed,filled"; color="#999999"; fillcolor="#f5f5f5";
        fontsize=12; fontname="DejaVu Sans"; fontcolor="#555555";

        d_anti [label="4 · ANTIRECON\ntcp flags XMAS / NULL / FIN+SYN / SYN+RST", shape=diamond, style="filled", fillcolor="#ffe6cc", color="#d79b00", height=1.0, width=2.6];
        t_anti [label="limit rate →\nlog \"SM-ANTIRECON\" → DROP", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];

        d_bl   [label="5 · BLACKLIST\nip saddr @sm_blacklist4/6 ?", shape=diamond, style="filled", fillcolor="#ffe6cc", color="#d79b00", height=0.95, width=2.4];
        t_bl   [label="DROP", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];

        d_wl   [label="6 · WHITELIST / SSoT\nip saddr @sm_whitelist4/6 ?", shape=diamond, style="filled", fillcolor="#ffe6cc", color="#d79b00", height=0.95, width=2.4];
        t_wl   [label="ACCEPT\n(bypass total — infra confiable)", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];

        d_geo  [label="7 · GEOIP (condicional)\nip saddr @geoip_<cc> ?", shape=diamond, style="filled", fillcolor="#ffe6cc", color="#d79b00", height=0.95, width=2.4];
        t_geo  [label="log \"SM-GEOIP\" → DROP\n(país no permitido)", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];

        // Alinear cada terminal con su decisión (dentro del cluster, conserva el recuadro)
        { rank=same; d_anti; t_anti; }
        { rank=same; d_bl;   t_bl;  }
        { rank=same; d_wl;   t_wl;  }
        { rank=same; d_geo;  t_geo; }
    }

    // ===== Zona SERVICIOS =====
    subgraph cluster_srv {
        label="SERVICIOS PERMITIDOS";
        style="dashed,filled"; color="#999999"; fillcolor="#f5f5f5";
        fontsize=12; fontname="DejaVu Sans"; fontcolor="#555555";
        srv [label="8 · tcp dport { 22 ssh, 80/443 acme/web }  → ACCEPT\nicmp / icmpv6 echo (limit rate)  → ACCEPT", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];
    }

    def [label="9 · POLICY DROP   ·   log \"SM-DROP-DEFAULT\"", shape=box, style="rounded,filled", fillcolor="#b85450", fontcolor="white", color="#7a2e2b", penwidth=1.5];

    // ===== Zona SETS (lateral) =====
    subgraph cluster_sets {
        label="SETS NATIVOS (flags interval)";
        style="rounded,filled"; color="#d6b656"; fillcolor="#fff2cc";
        fontsize=12; fontname="DejaVu Sans"; fontcolor="#7f6000";
        set_wl  [label="sm_whitelist4 / sm_whitelist6\n(SSoT — infra confiable)", shape=box, style="rounded,filled", fillcolor="#d5e8d4", color="#82b366"];
        set_bl  [label="sm_blacklist4 / sm_blacklist6\n(bans manuales)", shape=box, style="rounded,filled", fillcolor="#f8cecc", color="#b85450"];
        set_geo [label="geoip_<cc>4 / geoip_<cc>6\n(por país permitido)", shape=box, style="rounded,filled", fillcolor="#dae8fc", color="#6c8ebf"];
        set_f2b [label="tabla aparte: f2b-table\n(fail2ban · banaction nftables)\ncoexiste con inet sm", shape=box, style="rounded,filled", fillcolor="#e1d5e7", color="#9673a6"];
        set_nat [label="chain postrouting (type nat)\noifname $WAN masquerade\n(NAT WireGuard)", shape=box, style="rounded,filled", fillcolor="#ffe6cc", color="#d79b00"];
        set_wl -> set_bl -> set_geo -> set_f2b -> set_nat [style=invis];
    }

    // ===== Flujo principal =====
    pkt   -> chain [penwidth=1.5];
    chain -> s1    [penwidth=1.5];
    s1 -> s2 [label="no match"];
    s2 -> s3 [label="no match"];
    s3 -> d_anti [label="no match"];

    d_anti -> t_anti [label="match", color="#b85450", fontcolor="#b85450"];
    d_anti -> d_bl   [label="no match"];
    d_bl   -> t_bl   [label="match", color="#b85450", fontcolor="#b85450"];
    d_bl   -> d_wl   [label="no match"];
    d_wl   -> t_wl   [label="match", color="#82b366", fontcolor="#2e7d32"];
    d_wl   -> d_geo  [label="no match"];
    d_geo  -> t_geo  [label="país no permitido", color="#b85450", fontcolor="#b85450"];
    d_geo  -> srv    [label="permitido / sin geoip"];
    srv    -> def    [label="no match"];

    // ===== Referencias a sets (punteadas) =====
    d_bl  -> set_bl  [style=dashed, color="#b85450", arrowhead=open, constraint=false];
    d_wl  -> set_wl  [style=dashed, color="#82b366", arrowhead=open, constraint=false];
    d_geo -> set_geo [style=dashed, color="#6c8ebf", arrowhead=open, constraint=false];
}
